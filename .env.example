# ADMIN_INITIAL_PIN: Senha inicial de administrador do sistema OlariaFlow (mínimo 6 caracteres).
# Se não fornecida, uma senha aleatória segura é gerada e exibida nos logs do servidor.
ADMIN_INITIAL_PIN=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
